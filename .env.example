# Copy to .env and adjust. Every value below is the built-in default, so an empty
# environment behaves exactly like this file.
# Load it with:  node --env-file=.env src/api/server.js   (Node ≥ 20.6)
#           or:  set -a && . ./.env && set +a && npm run api

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bulkmove

# ── API ─────────────────────────────────────────────────────────────────────
PORT=3000
API_POOL_MAX=20            # API connection budget (separate from the worker's)

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_POOL_MAX=4          # worker connection budget; caps bulk load on the database
WORKER_CONCURRENCY=2       # jobs one worker process runs at once (always different workspaces)
CHUNK_SIZE=500             # deals per transaction; larger = faster, longer row locks
BULK_RATE_PER_SEC=5000     # per-job pacing in deals/s; 0 = unlimited. Lower it on small hardware
LEASE_SECONDS=30           # crash detection; must exceed the slowest chunk
POLL_MS=500                # idle wait between claim attempts

# ── Limits ──────────────────────────────────────────────────────────────────
MAX_JOB_SIZE=50000         # max deals per bulk job (more → 422 TOO_MANY_MATCHES)
MAX_PENDING_JOBS=10        # queued + running jobs per workspace (more → 429)

# ── Progress ────────────────────────────────────────────────────────────────
SLOW_AFTER_SECONDS=15      # no committed chunk for this long → health: slow

# ── Benchmark only (npm run bench) ──────────────────────────────────────────
BENCH_RPS=40               # interactive requests/s per workspace class
BENCH_BASELINE_S=15        # baseline duration in seconds
BENCH_PACED_RATE=5000      # pacing used for the "paced" run
# BENCH_TAG=1k-run1        # set to save a stress run as bench/results-<tag>.json
